{
  "name": "vestta",
  "version": "1.0.0",
  "description": "Vestta - Clothing store QA portfolio project",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:backend": "pnpm --filter backend dev",
    "test:e2e": "pnpm --filter e2e test",
    "test:api": "pnpm --filter backend test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "lint-staged": {
    "apps/frontend/src/**/*.{ts,tsx}": [
      "eslint --fix"
    ],
    "apps/backend/src/**/*.ts": [
      "eslint --fix"
    ],
    "tests/e2e/**/*.ts": [
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "typescript-eslint": "^8.62.1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
